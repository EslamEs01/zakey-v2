# ZAKEY v2 backend environment (FR-001).
# Copy to .env for local development. NEVER commit a real .env (threat T-11).

# development | production | test
DJANGO_ENV=development

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=insecure-development-key-override-in-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# PostgreSQL is required. SQLite is not supported and is rejected at startup:
# it silently ignores SELECT ... FOR UPDATE, which would make every concurrency
# guarantee a false negative (FR-002, NFR-005).
DATABASE_URL=postgres://zakey@127.0.0.1:5433/zakey
# Optional: point DATABASE_URL parsing at a non-default cluster binary path,
# e.g. when the OS ships multiple PostgreSQL versions. Existing env always wins.
# ZAKEY_PG_BIN_DIR=/usr/lib/postgresql/16/bin

DJANGO_LOG_LEVEL=INFO
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@zakey.example

# Production only: comma-separated https origins for CSRF.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://zakey.example

# Shipping and installation prices are BUSINESS INPUT that does not yet exist
# (ASM-004, ASM-005). Development seeds clearly-labelled placeholders. Production
# refuses to start on placeholders unless this is explicitly set to True, which
# must never be done for a real launch.
# ZAKEY_ALLOW_PLACEHOLDER_RATES=False

# Uploaded media is served by Django unless Nginx is configured with the
# /media/ alias from deploy/zakey-nginx.conf. Set to False once it is.
# ZAKEY_SERVE_MEDIA=True
